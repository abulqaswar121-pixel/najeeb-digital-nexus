# NDH Agency — environment variables
#
# As of this change, there IS a real backend (see server/) with real
# bcrypt-hashed passwords, signed httpOnly session cookies, and role-gated
# API endpoints, backed by a simple file-based store (server/data/*.json,
# gitignored, auto-seeded with demo data on first boot).
#
# Copy this file to `.env` for local development (already gitignored) and
# fill in real values. Never commit a real `.env`.

# --- Backend (server/) ---

# Signs session cookies (HS256 JWT). If unset, a random one is generated at
# process start (fine for a quick local test, but it means every restart
# invalidates all sessions, and it must never be left unset in anything that
# resembles production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Paystack SECRET key (server-only, never exposed to the client). Used to
# verify transaction references against Paystack's own API after a payment,
# and to validate webhook signatures. Without this, payments are recorded
# but explicitly marked as unverified ("sandbox") rather than silently
# pretending to be real.
PAYSTACK_SECRET_KEY=

# Origin the browser app is served from, for CORS. Defaults to
# http://localhost:3000 (this repo's Vite dev server port).
CLIENT_ORIGIN=http://localhost:3000

# Port the API process listens on. Defaults to 8787. The Vite dev server
# proxies /api/* to this port (see vite.config.ts).
API_PORT=8787

# --- Frontend (Vite, must be prefixed VITE_) ---

# Paystack PUBLIC key only (never put a secret key in a VITE_* variable --
# Vite inlines these into the shipped JS bundle for anyone to read). Get a
# test key from https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
